<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="BaseAddress" value="https://storage-api.fltrktv.ru" />
    <add key="Keycloak.Authority" value="https://keycloak.fltrktv.ru/realms/master" />
    <add key="Keycloak.ClientId" value="storage-desktop" />
    <add key="Keycloak.RedirectUri" value="http://localhost:45656/" />
    <add key="Keycloak.Scope" value="openid profile" />
    <add key="ThemeName" value="Light" />
  </appSettings>
</configuration>
