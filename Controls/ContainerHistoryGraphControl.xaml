<UserControl x:Class="StorageClient.Redesign.Controls.ContainerHistoryGraphControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StorageClient.Redesign.Controls"
             x:Name="Root"
             Background="{DynamicResource StorageSurfaceBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <DataGrid x:Name="HistoryGrid"
                  FontSize="11"
                  ItemsSource="{Binding Graph.Rows, ElementName=Root}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  ColumnHeaderHeight="58"
                  RowHeight="92"
                  MinRowHeight="92"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  EnableRowVirtualization="False"
                  EnableColumnVirtualization="False"
                  AlternationCount="2"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{DynamicResource StorageOutlineBrush}"
                  VerticalGridLinesBrush="{DynamicResource StorageOutlineBrush}"
                  Background="{DynamicResource StorageSurfaceBrush}"
                  BorderBrush="{DynamicResource StorageOutlineBrush}"
                  BorderThickness="1"
                  ScrollViewer.CanContentScroll="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Loaded="HistoryGrid_Loaded"
                  Unloaded="HistoryGrid_Unloaded">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Height" Value="92"/>
                    <Setter Property="Background" Value="{DynamicResource StorageSurfaceBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource StorageTextBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="AlternationIndex" Value="1">
                            <Setter Property="Background" Value="{DynamicResource StorageSurfaceMutedBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell"
                       BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource StorageOutlineBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Операция"
                                        Width="50*"
                                        MinWidth="115"
                                        CanUserResize="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="12,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding OperationName}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding OperationDateText}"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource StorageMutedTextBrush}"
                                               FontSize="11"/>
                                    <TextBlock Text="{Binding DetailText}"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource StorageMutedTextBrush}"
                                               FontSize="11"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasDetailText, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Margin="0,2,0,0"
                                               Foreground="{DynamicResource StorageMutedTextBrush}"
                                               FontSize="11"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasBasket, Converter={StaticResource BoolToVisibility}}">
                                        <Run Text="Корзина: "/>
                                        <Run Text="{Binding BasketDisplayName, Mode=OneWay}"/>
                                        <Run Text="{Binding BasketPositionText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Контейнер"
                                        Width="16*"
                                        MinWidth="59"
                                        CanUserResize="True"/>
                <DataGridTemplateColumn Header="Резерв"
                                        Width="16*"
                                        MinWidth="59"
                                        CanUserResize="True"/>
                <DataGridTemplateColumn Header="Выдача"
                                        Width="16*"
                                        MinWidth="59"
                                        CanUserResize="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- DataGrid управляет строками, колонками и прокруткой; Canvas рисует только граф поверх его тела. -->
        <Grid Margin="1,59,1,1"
              ClipToBounds="True">
            <Canvas Width="{Binding RenderedGraph.CanvasWidth, ElementName=Root}"
                    Height="{Binding RenderedGraph.CanvasHeight, ElementName=Root}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="GraphScrollTransform"/>
                </Canvas.RenderTransform>

                <ItemsControl Width="{Binding RenderedGraph.CanvasWidth, ElementName=Root}"
                              Height="{Binding RenderedGraph.CanvasHeight, ElementName=Root}"
                              ItemsSource="{Binding RenderedGraph.Edges, ElementName=Root}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="0"/>
                            <Setter Property="Canvas.Top" Value="0"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Path x:Name="EdgeHitArea"
                                      Data="{Binding Geometry}"
                                      Stroke="Transparent"
                                      StrokeThickness="14"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>

                                <Path x:Name="EdgePath"
                                      Data="{Binding Geometry}"
                                      Stroke="{DynamicResource StorageInfoBrush}"
                                      StrokeThickness="2"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      SnapsToDevicePixels="True"
                                      IsHitTestVisible="False"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSplitEdge}" Value="True">
                                    <Setter TargetName="EdgePath" Property="Stroke" Value="{DynamicResource StorageMutedTextBrush}"/>
                                </DataTrigger>
                                <Trigger SourceName="EdgeHitArea"
                                         Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="EdgePath" Property="Stroke" Value="#FFFFC107"/>
                                    <Setter TargetName="EdgePath" Property="StrokeThickness" Value="4"/>
                                    <Setter TargetName="EdgePath" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#FFFFC107"
                                                              BlurRadius="8"
                                                              ShadowDepth="0"
                                                              Opacity="0.9"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Width="{Binding RenderedGraph.CanvasWidth, ElementName=Root}"
                              Height="{Binding RenderedGraph.CanvasHeight, ElementName=Root}"
                              ItemsSource="{Binding RenderedGraph.Nodes, ElementName=Root}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding OpenDocumentCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:ContainerHistoryGraphControl}}}"
                                    CommandParameter="{Binding HistoryItem}"
                                    ToolTip="{Binding ToolTipText}"
                                    ToolTipService.InitialShowDelay="150"
                                    Cursor="Hand"
                                    Width="34" Height="34"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    ToolTipService.ShowOnDisabled="True">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid Width="34" Height="34">
                                    <Ellipse x:Name="NodeCircle"
                                             Fill="#FF1976D2"
                                             Stroke="White"
                                             StrokeThickness="1.5"/>
                                    <TextBlock Text="{Binding CountText}"
                                               Foreground="White"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Reserve">
                                    <Setter TargetName="NodeCircle" Property="Fill" Value="#FFD32F2F"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="FullyReserved">
                                    <Setter TargetName="NodeCircle" Property="Fill" Value="#FFF57C00"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Issue">
                                    <Setter TargetName="NodeCircle" Property="Fill" Value="#FF388E3C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </Grid>

    </Grid>
</UserControl>
