<mah:MetroWindow x:Class="StorageClient.Redesign.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:services="clr-namespace:StorageClient.Redesign.Services"
                 services:DialogCloser.DialogResult="{Binding DialogResult}"
                 mc:Ignorable="d"
                 Title="Вход в систему"
                 Width="1200"
                 Height="780"
                 MinWidth="900"
                 MinHeight="650"
                 WindowStartupLocation="CenterScreen"
                 TitleBarHeight="34"
                 ShowIconOnTitleBar="False"
                 ShowMaxRestoreButton="True"
                 GlowBrush="#665EA7FF"
                 NonActiveGlowBrush="#303D466B"
                 BorderBrush="#384E5A84"
                 WindowTitleBrush="#52080D1C"
                 NonActiveWindowTitleBrush="#68080D1C"
                 TitleForeground="#DDE6FF"
                 Background="#080C18">
    <mah:MetroWindow.Resources>
        <LinearGradientBrush x:Key="GlassPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D12A4775" Offset="0" />
            <GradientStop Color="#C5203863" Offset="0.48" />
            <GradientStop Color="#D0142347" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="GlassIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignToolButton}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#F4F6FF" />
            <Setter Property="Background" Value="#16FFFFFF" />
        </Style>

        <Style x:Key="GlassPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#FAFAFC" />
            <Setter Property="Foreground" Value="#202541" />
        </Style>

        <Style x:Key="GlassSecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="50" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#F4F6FF" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
        </Style>
    </mah:MetroWindow.Resources>

    <Grid Background="#102A5C">

        <Border Width="540"
                MaxHeight="680"
                Margin="40"
                Padding="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="29"
                BorderBrush="#42FFFFFF"
                BorderThickness="1"
                Background="#1CFFFFFF">
            <Border.Effect>
                <DropShadowEffect BlurRadius="42"
                                  ShadowDepth="0"
                                  Opacity="0.58"
                                  Color="#050713" />
            </Border.Effect>

            <Border CornerRadius="28" Background="{StaticResource GlassPanelBrush}">
                <Grid>
                    <Ellipse Width="210"
                             Height="210"
                             Margin="-92,-118,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Fill="#12FFFFFF" />
                    <Ellipse Width="180"
                             Height="180"
                             Margin="0,0,-104,-96"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Fill="#0D4DA5FF" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="50,34,50,32">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Command="{Binding ToggleThemeCommand}"
                                        Style="{StaticResource GlassIconButtonStyle}"
                                        ToolTip="Переключить тему">
                                    <Grid>
                                        <materialDesign:PackIcon Width="20" Height="20" Kind="WeatherNight">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <materialDesign:PackIcon Width="20" Height="20" Kind="WhiteBalanceSunny">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </Grid>
                                </Button>

                                <Border Grid.Column="1"
                                        Width="70"
                                        Height="70"
                                        HorizontalAlignment="Center"
                                        CornerRadius="22"
                                        Background="#18FFFFFF"
                                        BorderBrush="#32FFFFFF"
                                        BorderThickness="1">
                                    <materialDesign:PackIcon Width="39"
                                                             Height="39"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="#F5F7FF"
                                                             Kind="Warehouse" />
                                </Border>

                                <Button x:Name="ServerSettingsButton"
                                        Grid.Column="2"
                                        Command="{Binding OpenSettingsCommand}"
                                        IsEnabled="{Binding IsNotBusy}"
                                        Style="{StaticResource GlassIconButtonStyle}"
                                        ToolTip="Настроить API">
                                    <materialDesign:PackIcon Width="20" Height="20" Kind="CogOutline" />
                                </Button>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Margin="0,22,0,0"
                                       HorizontalAlignment="Center"
                                       Text="Вход в систему"
                                       FontSize="34"
                                       FontWeight="Light"
                                       Foreground="#FAFBFF" />

                            <TextBlock Grid.Row="2"
                                       Margin="18,9,18,0"
                                       HorizontalAlignment="Center"
                                       Text="Войдите, чтобы получить доступ к складу"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       LineHeight="20"
                                       Foreground="#BFC7E4" />

                            <Border Grid.Row="3"
                                    Margin="0,18,0,0"
                                    Padding="13,10"
                                    CornerRadius="13"
                                    Background="#31B42318"
                                    BorderBrush="#45FF9B94"
                                    BorderThickness="1"
                                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Width="19"
                                                             Height="19"
                                                             VerticalAlignment="Top"
                                                             Foreground="#FFC0BC"
                                                             Kind="AlertCircleOutline" />
                                    <TextBlock Grid.Column="1"
                                               Margin="9,0,0,0"
                                               Text="{Binding ErrorMessage}"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               LineHeight="17"
                                               Foreground="#FFE1DE" />
                                </Grid>
                            </Border>

                            <Button Grid.Row="4"
                                    Margin="0,22,0,0"
                                    Command="{Binding SignInCommand}"
                                    IsDefault="True"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Style="{StaticResource GlassPrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Width="21"
                                                             Height="21"
                                                             VerticalAlignment="Center"
                                                             Foreground="#285FD6"
                                                             Kind="ShieldKeyOutline" />
                                    <TextBlock Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Войти через Keycloak"
                                               Foreground="#202541" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="5"
                                    Margin="0,12,0,0"
                                    Command="{Binding SignInAsDifferentUserCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Style="{StaticResource GlassSecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Width="20"
                                                             Height="20"
                                                             VerticalAlignment="Center"
                                                             Foreground="#C9C4FF"
                                                             Kind="AccountSwitchOutline" />
                                    <TextBlock Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Выбрать другую учётную запись"
                                               Foreground="#F4F6FF" />
                                </StackPanel>
                            </Button>

                            <Grid Grid.Row="6" Margin="0,18,0,0">
                                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ProgressBar Height="4"
                                                 IsIndeterminate="True"
                                                 Foreground="#5EA1FF" />
                                    <TextBlock Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               Text="Ожидаем завершения авторизации…"
                                               FontSize="11"
                                               Foreground="#AEB7D7" />
                                </StackPanel>

                            </Grid>

                            <Popup IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=ServerSettingsButton}"
                                   Placement="Bottom"
                                   HorizontalOffset="-330"
                                   VerticalOffset="8"
                                   AllowsTransparency="True"
                                   StaysOpen="False">
                                <Border Width="390"
                                        Padding="20"
                                        CornerRadius="18"
                                        Background="{DynamicResource StorageSurfaceBrush}"
                                        BorderBrush="{DynamicResource StorageOutlineBrush}"
                                        BorderThickness="1"
                                        materialDesign:ElevationAssist.Elevation="Dp8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Подключение к API"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource StorageTextBrush}" />
                                                <TextBlock Margin="0,5,0,0"
                                                           Text="Новый адрес применяется после перезапуска"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource StorageMutedTextBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Command="{Binding CloseSettingsCommand}"
                                                    Style="{StaticResource StorageIconButtonStyle}"
                                                    ToolTip="Закрыть">
                                                <materialDesign:PackIcon Width="20" Height="20" Kind="Close" />
                                            </Button>
                                        </Grid>

                                        <TextBox Margin="0,18,0,0"
                                                 Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Адрес API"
                                                 Style="{StaticResource StorageOutlinedTextBoxStyle}" />

                                        <TextBlock Margin="3,7,3,0"
                                                   Text="{Binding ServerAddressValidationMessage}"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource StorageDangerBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsServerAddressValid}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Margin="0,12,0,0"
                                                Padding="12,9"
                                                CornerRadius="11"
                                                Background="{DynamicResource StorageWarningSurfaceBrush}"
                                                Visibility="{Binding IsServerAddressModified, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="Изменение адреса потребует перезапуска клиента."
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource StorageWarningBrush}" />
                                        </Border>

                                        <Button Margin="0,16,0,0"
                                                HorizontalAlignment="Right"
                                                Content="Сохранить и перезапустить"
                                                Command="{Binding SaveServerAndRestartCommand}"
                                                Style="{StaticResource StoragePrimaryButtonStyle}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
    </Grid>
</mah:MetroWindow>
