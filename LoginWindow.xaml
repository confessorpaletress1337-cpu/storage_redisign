<mah:MetroWindow x:Class="StorageClient.Redesign.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:services="clr-namespace:StorageClient.Redesign.Services"
                 services:DialogCloser.DialogResult="{Binding DialogResult}"
                 mc:Ignorable="d"
                 Title="Вход в систему"
                 Width="920"
                 Height="600"
                 MinWidth="920"
                 MinHeight="600"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ShowMaxRestoreButton="False"
                 ShowMinButton="True"
                 ShowIconOnTitleBar="False"
                 TitleBarHeight="38"
                 GlowBrush="{DynamicResource StorageBrandMidBrush}"
                 NonActiveGlowBrush="{DynamicResource StorageOutlineBrush}"
                 BorderBrush="{DynamicResource StorageOutlineBrush}"
                 Background="{DynamicResource StorageShellBrush}">
    <Grid Background="{DynamicResource StorageShellBrush}">
        <Border Margin="24"
                Style="{StaticResource StorageCardStyle}"
                CornerRadius="24"
                materialDesign:ElevationAssist.Elevation="Dp8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="23,0,0,23">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{DynamicResource StorageBrandStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource StorageBrandMidColor}" Offset="0.58" />
                            <GradientStop Color="{DynamicResource StorageBrandEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid Margin="36">
                        <Ellipse Width="190"
                                 Height="190"
                                 Margin="-118,-116,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Fill="#16FFFFFF" />
                        <Ellipse Width="150"
                                 Height="150"
                                 Margin="0,0,-92,-92"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Fill="#14FFFFFF" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <Border Width="70"
                                        Height="70"
                                        HorizontalAlignment="Left"
                                        CornerRadius="20"
                                        Background="#22FFFFFF">
                                    <materialDesign:PackIcon Width="40"
                                                             Height="40"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="White"
                                                             Kind="Warehouse" />
                                </Border>

                                <TextBlock Margin="0,24,0,0"
                                           Text="Склад"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="White" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="Рабочее пространство учёта и движения материальных ценностей"
                                           FontSize="14"
                                           LineHeight="21"
                                           TextWrapping="Wrap"
                                           Foreground="#E4F5F6" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <Border Padding="15,12"
                                        CornerRadius="14"
                                        Background="#18FFFFFF">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Width="22"
                                                                 Height="22"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource StorageAccentBrush}"
                                                                 Kind="ShieldLockOutline" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="Защищённый вход"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="White" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="Keycloak · OpenID Connect"
                                                       FontSize="12"
                                                       Foreground="#D5EEF0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Margin="0,12,0,0"
                                        Padding="15,12"
                                        CornerRadius="14"
                                        Background="#18FFFFFF">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Width="22"
                                                                 Height="22"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource StorageAccentBrush}"
                                                                 Kind="DatabaseCheckOutline" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="API склада"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="White" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="Проверка профиля после входа"
                                                       FontSize="12"
                                                       Foreground="#D5EEF0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Padding="14,11"
                                    CornerRadius="14"
                                    Background="#1A000000">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9"
                                             Height="9"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource StorageAccentBrush}" />
                                    <TextBlock Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Подключение настраивается перед входом"
                                               FontSize="11"
                                               Foreground="White" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="46,36">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Добро пожаловать"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource StorageTextBrush}" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="Авторизуйтесь через корпоративную страницу входа"
                                       FontSize="13"
                                       Foreground="{DynamicResource StorageMutedTextBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding ToggleThemeCommand}"
                                Style="{StaticResource StorageIconButtonStyle}"
                                ToolTip="Переключить тему">
                            <Grid>
                                <materialDesign:PackIcon Width="21" Height="21" Kind="WeatherNight">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <materialDesign:PackIcon Width="21" Height="21" Kind="WhiteBalanceSunny">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Grid>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,28,0,0"
                            Padding="15,12"
                            Style="{StaticResource StorageCardStyle}"
                            Background="{DynamicResource StorageSurfaceMutedBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="42"
                                    Height="42"
                                    CornerRadius="12"
                                    Background="{DynamicResource StorageInfoSurfaceBrush}">
                                <materialDesign:PackIcon Width="21"
                                                         Height="21"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource StorageInfoBrush}"
                                                         Kind="ServerNetwork" />
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="12,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Активный сервер"
                                           FontSize="11"
                                           Foreground="{DynamicResource StorageMutedTextBrush}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding ActiveServerAddress}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource StorageTextBrush}"
                                           ToolTip="{Binding ActiveServerAddress}" />
                            </StackPanel>

                            <Button x:Name="ServerSettingsButton"
                                    Grid.Column="2"
                                    Command="{Binding OpenSettingsCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Style="{StaticResource StorageIconButtonStyle}"
                                    ToolTip="Настроить адрес API">
                                <materialDesign:PackIcon Width="21" Height="21" Kind="CogOutline" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Margin="0,16,0,0"
                            Padding="14,11"
                            CornerRadius="13"
                            Background="{DynamicResource StorageInfoSurfaceBrush}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="20"
                                                     Height="20"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource StorageInfoBrush}"
                                                     Kind="OpenInNew" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="Страница входа откроется в браузере"
                                       FontSize="12"
                                       Foreground="{DynamicResource StorageInfoBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3"
                            Margin="0,12,0,0"
                            Padding="14,11"
                            CornerRadius="13"
                            Background="{DynamicResource StorageDangerSurfaceBrush}"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Width="20"
                                                     Height="20"
                                                     Foreground="{DynamicResource StorageDangerBrush}"
                                                     Kind="AlertCircleOutline" />
                            <TextBlock Grid.Column="1"
                                       Margin="10,0,0,0"
                                       Text="{Binding ErrorMessage}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       LineHeight="18"
                                       Foreground="{DynamicResource StorageDangerBrush}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="4" Margin="0,22,0,0">
                        <Button Command="{Binding SignInCommand}"
                                IsDefault="True"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource StoragePrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Width="21"
                                                         Height="21"
                                                         VerticalAlignment="Center"
                                                         Foreground="White"
                                                         Kind="LoginVariant" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="Войти через браузер"
                                           Foreground="White" />
                            </StackPanel>
                        </Button>

                        <Button Margin="0,10,0,0"
                                Content="Войти под другой учётной записью"
                                Command="{Binding SignInAsDifferentUserCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource StorageSecondaryButtonStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="5"
                                Margin="0,16,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar Height="5"
                                     IsIndeterminate="True"
                                     Foreground="{DynamicResource StorageBrandMidBrush}" />
                        <TextBlock Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Text="Ожидаем завершения авторизации…"
                                   FontSize="12"
                                   Foreground="{DynamicResource StorageMutedTextBrush}" />
                    </StackPanel>

                    <TextBlock Grid.Row="6"
                               Margin="0,0,0,2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Text="Storage Client · стартовый макет"
                               FontSize="11"
                               Foreground="{DynamicResource StorageMutedTextBrush}" />

                    <Popup Grid.Row="1"
                           IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=ServerSettingsButton}"
                           Placement="Bottom"
                           HorizontalOffset="-320"
                           VerticalOffset="8"
                           AllowsTransparency="True"
                           StaysOpen="False">
                        <Border Width="380"
                                Padding="20"
                                Style="{StaticResource StorageCardStyle}"
                                Background="{DynamicResource StorageSurfaceBrush}"
                                materialDesign:ElevationAssist.Elevation="Dp8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Подключение к API"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource StorageTextBrush}" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="Новый адрес применяется после перезапуска"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource StorageMutedTextBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Command="{Binding CloseSettingsCommand}"
                                            Style="{StaticResource StorageIconButtonStyle}"
                                            ToolTip="Закрыть">
                                        <materialDesign:PackIcon Width="20" Height="20" Kind="Close" />
                                    </Button>
                                </Grid>

                                <TextBox Margin="0,18,0,0"
                                         Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Адрес API"
                                         Style="{StaticResource StorageOutlinedTextBoxStyle}" />

                                <TextBlock Margin="3,7,3,0"
                                           Text="{Binding ServerAddressValidationMessage}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{DynamicResource StorageDangerBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsServerAddressValid}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Border Margin="0,12,0,0"
                                        Padding="12,9"
                                        CornerRadius="11"
                                        Background="{DynamicResource StorageWarningSurfaceBrush}"
                                        Visibility="{Binding IsServerAddressModified, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Изменение адреса потребует перезапуска клиента."
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource StorageWarningBrush}" />
                                </Border>

                                <Button Margin="0,16,0,0"
                                        HorizontalAlignment="Right"
                                        Content="Сохранить и перезапустить"
                                        Command="{Binding SaveServerAndRestartCommand}"
                                        Style="{StaticResource StoragePrimaryButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>
