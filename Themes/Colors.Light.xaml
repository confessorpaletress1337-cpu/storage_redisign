<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="StorageBrandStartColor">#0E4F59</Color>
    <Color x:Key="StorageBrandMidColor">#176C7A</Color>
    <Color x:Key="StorageBrandEndColor">#4D98A2</Color>
    <Color x:Key="StorageAccentColor">#F4C95D</Color>

    <Color x:Key="StorageShellColor">#EEF3F7</Color>
    <Color x:Key="StorageSurfaceColor">#FFFFFF</Color>
    <Color x:Key="StorageSurfaceMutedColor">#F7FAFC</Color>
    <Color x:Key="StorageTextColor">#22303A</Color>
    <Color x:Key="StorageMutedTextColor">#687683</Color>
    <Color x:Key="StorageOutlineColor">#DCE6EC</Color>
    <Color x:Key="StorageSelectionColor">#CFE8EB</Color>
    <Color x:Key="StorageInactiveSelectionColor">#E2EEF0</Color>

    <Color x:Key="StorageSuccessColor">#237A50</Color>
    <Color x:Key="StorageSuccessSurfaceColor">#D8F3E3</Color>
    <Color x:Key="StorageWarningColor">#7B5A10</Color>
    <Color x:Key="StorageWarningSurfaceColor">#FFF4D6</Color>
    <Color x:Key="StorageDangerColor">#B42318</Color>
    <Color x:Key="StorageDangerSurfaceColor">#FDE8E7</Color>
    <Color x:Key="StorageInfoColor">#245E9B</Color>
    <Color x:Key="StorageInfoSurfaceColor">#E5F0FC</Color>

    <SolidColorBrush x:Key="StorageBrandStartBrush" Color="{DynamicResource StorageBrandStartColor}" />
    <SolidColorBrush x:Key="StorageBrandMidBrush" Color="{DynamicResource StorageBrandMidColor}" />
    <SolidColorBrush x:Key="StorageBrandEndBrush" Color="{DynamicResource StorageBrandEndColor}" />
    <SolidColorBrush x:Key="StorageAccentBrush" Color="{DynamicResource StorageAccentColor}" />
    <SolidColorBrush x:Key="StorageShellBrush" Color="{DynamicResource StorageShellColor}" />
    <SolidColorBrush x:Key="StorageSurfaceBrush" Color="{DynamicResource StorageSurfaceColor}" />
    <SolidColorBrush x:Key="StorageSurfaceMutedBrush" Color="{DynamicResource StorageSurfaceMutedColor}" />
    <SolidColorBrush x:Key="StorageTextBrush" Color="{DynamicResource StorageTextColor}" />
    <SolidColorBrush x:Key="StorageMutedTextBrush" Color="{DynamicResource StorageMutedTextColor}" />
    <SolidColorBrush x:Key="StorageOutlineBrush" Color="{DynamicResource StorageOutlineColor}" />
    <SolidColorBrush x:Key="StorageSelectionBrush" Color="{DynamicResource StorageSelectionColor}" />
    <SolidColorBrush x:Key="StorageInactiveSelectionBrush" Color="{DynamicResource StorageInactiveSelectionColor}" />
    <SolidColorBrush x:Key="StorageSuccessBrush" Color="{DynamicResource StorageSuccessColor}" />
    <SolidColorBrush x:Key="StorageSuccessSurfaceBrush" Color="{DynamicResource StorageSuccessSurfaceColor}" />
    <SolidColorBrush x:Key="StorageWarningBrush" Color="{DynamicResource StorageWarningColor}" />
    <SolidColorBrush x:Key="StorageWarningSurfaceBrush" Color="{DynamicResource StorageWarningSurfaceColor}" />
    <SolidColorBrush x:Key="StorageDangerBrush" Color="{DynamicResource StorageDangerColor}" />
    <SolidColorBrush x:Key="StorageDangerSurfaceBrush" Color="{DynamicResource StorageDangerSurfaceColor}" />
    <SolidColorBrush x:Key="StorageInfoBrush" Color="{DynamicResource StorageInfoColor}" />
    <SolidColorBrush x:Key="StorageInfoSurfaceBrush" Color="{DynamicResource StorageInfoSurfaceColor}" />
</ResourceDictionary>
