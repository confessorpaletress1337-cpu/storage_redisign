<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="StoragePrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource StorageBrandMidBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="StorageSecondaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource StorageBrandMidBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StorageBrandMidBrush}" />
    </Style>

    <Style x:Key="StorageIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MaterialDesignToolButton}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource StorageTextBrush}" />
    </Style>

    <Style x:Key="StorageOutlinedTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource StorageTextBrush}" />
    </Style>

    <Style x:Key="StorageCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource StorageSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StorageOutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>
</ResourceDictionary>
